#!/usr/bin/env bash
set -euo pipefail
cd "$(dirname "$0")/.."

CLEAN=0
for arg in "$@"; do
  case "$arg" in
    -c|--clean) CLEAN=1 ;;
    *) echo "Usage: bin/test [-c|--clean]" >&2; exit 2 ;;
  esac
done

COMPILER_DIR="$(cd ../purust && pwd)"
SPAGO_BIN="$COMPILER_DIR/node_modules/.bin/spago"
if [ ! -x "$SPAGO_BIN" ]; then
  printf 'Missing Spago dependency. Run npm install in %s.\n' "$COMPILER_DIR" >&2
  exit 1
fi
# Prefer the sibling TAST fork; PURS can select another build explicitly.
if [ -n "${PURS:-}" ]; then
  PURS_BIN="$(command -v "$PURS")"
else
  FORK_BUILDS=("$COMPILER_DIR"/../../purescript/.stack-work/dist/*/*/build/purs/purs)
  if [ "${#FORK_BUILDS[@]}" = 1 ] && [ -x "${FORK_BUILDS[0]}" ]; then
    PURS_BIN="${FORK_BUILDS[0]}"
  else
    PURS_BIN="$(command -v purs)"
  fi
fi
export PATH="$(dirname "$PURS_BIN"):$COMPILER_DIR/node_modules/.bin:$PATH"
if [ "$CLEAN" = 1 ]; then
  echo "=== Recompiling purust ==="
  # Run Spago directly with the TAST-enabled compiler first on PATH. `npm run
  # build` would inject ancestor `node_modules/.bin` directories, and an old
  # PureScript at the workspace root (or the missing local fork download)
  # would otherwise win.
  (cd "$COMPILER_DIR" && "$SPAGO_BIN" build \
    && "$SPAGO_BIN" bundle --module Main --platform node --outfile bin/purust.js --bundle-type app)
fi

# Clean this package only. Always regenerate its TAST and Rust output.
rm -rf output
if [ "$CLEAN" = 1 ]; then
  rm -rf .spago .cache
fi

echo "=== Building TAST and generating Rust with spago ==="
"$SPAGO_BIN" build
node -e 'const fs = require("node:fs"); const m = JSON.parse(fs.readFileSync("output/Test.Main/corefn.json", "utf8")); if (!Array.isArray(m.dataDecls)) { console.error("A TAST-enabled PureScript fork is required; set PURS to its executable."); process.exit(1); }'

echo "=== Compiling Rust FFI and tests ==="
cargo build --manifest-path output/purust_output/Cargo.toml

echo "=== Running the Node.Stream tests ==="
BINARY="output/purust_output/target/debug/purust_output"
status=0
node -e 'const { spawnSync } = require("node:child_process"); const result = spawnSync(process.argv[1], [], { stdio: "inherit", timeout: 60000 }); if (result.error) console.error(result.error.message); process.exit(result.status ?? 1);' "$BINARY" > output/actual.stdout 2> output/actual.stderr || status=$?
cat output/actual.stdout
if [ "$status" -ne 0 ] || [ -s output/actual.stderr ]; then
  cat output/actual.stderr >&2
  echo "[FAILED] Node.Stream tests exited with status $status" >&2
  exit 1
fi
if ! grep -q 'Tests passed' output/actual.stdout; then
  echo "[FAILED] Node.Stream tests did not reach the final marker" >&2
  exit 1
fi
echo "=== Running the overflow PassThrough test (Test.Main2) ==="
"$COMPILER_DIR/bin/purust" --source output --out output/purust_output --main Test.Main2 --threaded
cargo build --manifest-path output/purust_output/Cargo.toml
status=0
node -e 'const { spawnSync } = require("node:child_process"); const result = spawnSync(process.argv[1], [], { stdio: "inherit", timeout: 120000 }); if (result.error) console.error(result.error.message); process.exit(result.status ?? 1);' "$BINARY" > output/main2.stdout 2> output/main2.stderr || status=$?
cat output/main2.stdout
if [ "$status" -ne 0 ] || [ -s output/main2.stderr ] || ! grep -q 'Tests passed' output/main2.stdout; then
  cat output/main2.stderr >&2
  echo "[FAILED] Test.Main2 exited with status $status" >&2
  exit 1
fi

# The upstream `Test.Main1`, `Test.Main3` and `Test.Main4` each have their own
# entry point; build and run them on demand.
run_extra_main() {
  local main="$1" label="$2"
  shift 2
  echo "=== Running $label (Test.$main) ==="
  "$COMPILER_DIR/bin/purust" --source output --out output/purust_output --main "Test.$main" --threaded
  cargo build --manifest-path output/purust_output/Cargo.toml
  local status=0
  CHILD_TIMEOUT_MS=180000 node -e 'const { spawnSync } = require("node:child_process"); const result = spawnSync(process.argv[1], process.argv.slice(2), { stdio: "inherit", timeout: Number(process.env.CHILD_TIMEOUT_MS || 60000) }); if (result.error) console.error(result.error.message); process.exit(result.status ?? 1);' "$BINARY" "$@" > "output/$main.stdout" 2> "output/$main.stderr" || status=$?
  cat "output/$main.stdout"
  if [ "$status" -ne 0 ] || [ -s "output/$main.stderr" ]; then
    cat "output/$main.stderr" >&2
    echo "[FAILED] Test.$main exited with status $status" >&2
    exit 1
  fi
  if ! grep -qE '[0-9]+/[0-9]+ tests? passed' "output/$main.stdout"; then
    echo "[FAILED] Test.$main did not report a passing summary" >&2
    exit 1
  fi
}

run_extra_main Main1 "Aff readers, destroyed streams and file streams"
run_extra_main Main4 "blocked readSome and the event loop"
head -c 1000000 /dev/zero > output/zeros.bin
run_extra_main Main3 "1 MiB file stream" "$PWD/output/zeros.bin"

echo "Summary: the native Node.Stream tests passed (default suite, Test.Main1 to Test.Main4)."
